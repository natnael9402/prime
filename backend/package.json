{
  "name": "digital-store-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "apphosting:build": "prisma generate --schema prisma/schema.postgres.prisma && nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "prisma:generate": "prisma generate",
    "prisma:generate:pg": "prisma generate --schema prisma/schema.postgres.prisma",
    "prisma:db:push": "prisma db push",
    "prisma:db:push:pg": "prisma db push --schema prisma/schema.postgres.prisma",
    "migrate:pg": "node scripts/migrate-sqlite-to-pg.js",
    "seed": "ts-node src/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1103.0",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^5.9.1",
    "axios": "^1.6.7",
    "bullmq": "^6.0.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "lodash": "^4.18.1",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.2",
    "prisma": "^5.9.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
