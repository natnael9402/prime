generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Category {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  icon      String
  emojiId   String?
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model HomeCard {
  id             String   @id @default(uuid())
  enabled        Boolean  @default(true)
  order          Int      @default(0)
  kind           String   @default("hero") // hero | promo
  badgeText      String?
  title          String
  subtitle       String?
  icon           String?                   // sparkles | handcoins | zap | shield | package
  linkType       String   @default("none") // none | product | url
  productId      String?
  linkUrl        String?
  animatedBorder Boolean  @default(false)
  priceText      String?
  imageUrl       String?
  borderStyle    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model TgUser {
  id                  String   @id @default(uuid())
  telegramId          String   @unique
  firstName           String?
  lastName            String?
  username            String?
  photoUrl            String?
  languageCode        String?
  referralCode        String?  @unique
  invitedById         String?
  inviteVerified      Boolean  @default(false)
  storeCredit         Float    @default(0)
  customDiscountPct   Float    @default(0)
  isBanned            Boolean  @default(false)
  banReason           String?
  adminNote           String?
  productsViewedCount Int      @default(0)
  lastActiveAt        DateTime @default(now())
  createdAt           DateTime @default(now())
  lastSeenAt          DateTime @updatedAt
}

model Product {
  id               String            @id @default(uuid())
  name             String
  slug             String            @unique
  description      String
  shortDesc        String
  price            Float
  originalPrice    Float?
  currency         String            @default("ETB")
  badge            String?
  emojiId          String?
  bannerUrl        String
  gallery          String
  features         String
  requirements     String
  translations     String            @default("{}")
  stock            Int               @default(0)
  instantDelivery  Boolean           @default(true)
  isFeatured       Boolean           @default(false)
  source           String            @default("LOCAL")
  supplierProductId String?
  costUSD          Float?
  priceMode        String            @default("MANUAL")
  marginMultiplier Float?
  discountPct      Float             @default(0)
  categoryId       String
  category         Category          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  licenseKeys      LicenseKey[]
  stockAlerts      StockAlert[]
  activationGuide  ActivationGuide?
  orders           Order[]
  rewardTiers      RewardTier[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model LicenseKey {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  code      String
  isUsed    Boolean  @default(false)
  orderId   String?
  createdAt DateTime @default(now())
}

model ActivationGuide {
  id          String   @id @default(uuid())
  productId   String   @unique
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  steps       String
  downloadUrl String?
  notes       String?
  videoUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Affiliate {
  id               String       @id @default(uuid())
  code             String       @unique
  name             String
  phone            String?
  email            String?
  telegramUserId   String?
  telegramUsername String?
  status           String       @default("ACTIVE")
  commissionRate   Float        @default(0.10)
  clicks           Int          @default(0)
  payoutMethod     String?
  payoutAccount    String?
  orders           Order[]
  payoutRequests   PayoutRequest[]
  commissions      Commission[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model Commission {
  id          String    @id @default(uuid())
  affiliateId String
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  orderId     String    @unique
  amount      Float
  rate        Float
  status      String    @default("PENDING")
  paidAt      DateTime?
  note        String?
  createdAt   DateTime  @default(now())
}

model Order {
  id                String     @id @default(uuid())
  txRef             String     @unique
  cartRef           String?
  telegramUserId    String?
  telegramUsername  String?
  customerEmail     String
  customerPhone     String?
  customerName      String
  productId         String
  product           Product    @relation(fields: [productId], references: [id])
  quantity          Int        @default(1)
  amount            Float
  currency          String     @default("ETB")
  status            String     @default("PENDING")
  licenseKey        String?
  paymentUrl        String?
  chapaTxRef        String?
  paymentMode       String     @default("mock")
  fulfillmentStatus String     @default("NONE")
  supplierOrderId   String?
  fulfillmentError  String?
  refCode           String?
  affiliateId       String?
  affiliate         Affiliate? @relation(fields: [affiliateId], references: [id])
  commissionAmount  Float?
  creditUsed        Float?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
}

model AdminUser {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PayoutRequest {
  id          String    @id @default(uuid())
  affiliateId String
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  amount      Float
  method      String // telebirr | cbe
  account     String
  status      String    @default("PENDING") // PENDING | PAID | REJECTED
  note        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model StockAlert {
  id             String   @id @default(uuid())
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  telegramUserId String
  username       String?
  firstName      String?
  createdAt      DateTime @default(now())

  @@unique([productId, telegramUserId])
}

model Broadcast {
  id             String    @id @default(uuid())
  productId      String?
  productName    String
  productUrl     String
  imageUrl       String
  caption        String
  buttonText     String
  status         String    @default("RUNNING") // RUNNING | COMPLETED | FAILED
  total          Int       @default(0)
  sent           Int       @default(0)
  failed         Int       @default(0)
  failureSummary String    @default("{}")
  error          String?
  createdAt      DateTime  @default(now())
  completedAt    DateTime?
}

model RewardTier {
  id              String        @id @default(uuid())
  title           String
  description     String?
  requiredInvites Int
  rewardType      String        @default("PRODUCT") // PRODUCT | STORE_CREDIT
  productId       String?
  product         Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  creditAmount    Float?
  autoDeliver     Boolean       @default(true)
  enabled         Boolean       @default(true)
  order           Int           @default(0)
  claims          RewardClaim[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model RewardClaim {
  id             String     @id @default(uuid())
  telegramUserId String
  tierId         String
  tier           RewardTier @relation(fields: [tierId], references: [id], onDelete: Cascade)
  status         String     @default("DELIVERED") // PENDING | DELIVERED | REJECTED
  orderId        String?
  licenseKey     String?
  note           String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([telegramUserId, tierId])
}

model UserEvent {
  id           String   @id @default(uuid())
  telegramId   String
  eventType    String   // BOT_START | CATEGORY_VIEW | PRODUCT_VIEW | SEARCH | BUY_CLICK | ORDER_PAID | REWARD_CLAIM | STOCK_ALERT
  productId    String?
  productName  String?
  categorySlug String?
  query        String?
  orderId      String?
  amount       Float?
  meta         String?
  createdAt    DateTime @default(now())

  @@index([telegramId, createdAt])
  @@index([eventType, createdAt])
  @@index([productId, eventType])
}
